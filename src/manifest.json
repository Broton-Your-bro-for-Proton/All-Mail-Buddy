{
  "manifest_version": 2,
  "name": "All Mail Buddy for Proton",
  "version": "0.2.15",
  "description": "__MSG_extensionDescription__",
  "author": "HyperCriSiS",
  "homepage_url": "https://github.com/Broton-Your-bro-for-Proton/All-Mail-Buddy",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "allmailplus@hypercrisis",
      "strict_min_version": "153.0",
      "strict_max_version": "160.*",
      "update_url": "https://raw.githubusercontent.com/Broton-Your-bro-for-Proton/All-Mail-Buddy/main/updates.json"
    }
  },
  "icons": { "64": "icons/icon.svg" },
  "permissions": ["storage", "notifications"],
  "background": { "scripts": ["lib/i18n.js", "background.js"] },
  "browser_action": { "default_icon": "icons/icon.svg", "default_title": "All Mail Buddy" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "experiment_apis": {
    "allMailPlus": {
      "schema": "api/allMailPlus/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["allMailPlus"]],
        "script": "api/allMailPlus/implementation.js"
      }
    }
  }
}
